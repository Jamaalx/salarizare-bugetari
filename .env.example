# NVIDIA NIM API for the AI chat widget (/api/chat).
# Get a key from https://build.nvidia.com (free tier available for testing).
# If unset, /api/chat returns 503 NOT_CONFIGURED and the chat widget falls back gracefully.
NVIDIA_API_KEY=

# Override the default model. Defaults to "meta/llama-3.3-70b-instruct".
# Other options: "meta/llama-3.1-405b-instruct", "mistralai/mistral-large-2-instruct"
NVIDIA_MODEL=

# HMAC secret used to sign OAuth tokens for the MCP server (/oauth/*, lib/oauth.ts).
# At least 32 characters. If unset/short, OAuth is DISABLED (/oauth/* answer 503,
# no authorization server is advertised) and /api/mcp stays public/anonymous.
# There is no fallback secret. Generate one with: openssl rand -hex 32
OAUTH_SIGNING_SECRET=

# Optional: extra exact redirect_uri values accepted by /oauth/authorize and
# /oauth/register, comma-separated. Always allowed: the Claude connector
# (https://claude.ai|claude.com/api/mcp/auth_callback), ChatGPT
# (https://chatgpt.com/connector_platform_oauth_redirect) and http://localhost / 127.0.0.1.
OAUTH_REDIRECT_ALLOWLIST=
